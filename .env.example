# Copy this file to .env and fill in the values for your local setup.
# .env is git-ignored — never commit it.

# ── Azure Blob Storage ────────────────────────────────────────────────────────
# Connection string from Azure Portal → Storage Account → Access keys
AZURE_STORAGE_CONNECTION_STRING=your_connection_string_here

# ── PostgreSQL connection ─────────────────────────────────────────────────────
# Async asyncpg driver.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@localhost:5433/pharmacast_db

# ── Historical data window ────────────────────────────────────────────────────
# Max days of historical data returned/persisted per execution for chart preview.
# Optional — defaults to 90 if not set. Model training always uses the full
# accumulated history from blob, unaffected by this value.
HISTORICAL_WINDOW_DAYS=LIMIT_NUMBER_OF_DAYS_FOR_CHART_PREVIEW
