# Copy this file to .env and fill in the values for your local setup.
# .env is git-ignored — never commit it.

# ── Local storage (default for presentations) ─────────────────────────────────
LOCAL_STORAGE_ENABLED=true
# LOCAL_STORAGE_ROOT=C:/path/to/local-storage

# Fast illustrative forecast for the presentation; disable for real XGBoost training.
PRESENTATION_MODE=false
XGBOOST_N_JOBS=4

# ── Azure Blob Storage (only when LOCAL_STORAGE_ENABLED=false) ────────────────
# AZURE_STORAGE_CONNECTION_STRING=your_connection_string_here
HISTORICAL_DATASETS_CONTAINER=historical-datasets
MODEL_ARTIFACTS_CONTAINER=model-artifacts

# Business database persistence belongs exclusively to the backend.
# DATABASE_URL is not required or used by the ML runtime.
